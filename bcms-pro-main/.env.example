APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file

# Bridge interface status (/api/status-check/bridge-status?function=interface)
BRIDGE_STATUS_INTERFACE_CACHE_SECONDS=120
BRIDGE_STATUS_INTERFACE_ROW_CUTOFF_DAYS=0
BRIDGE_STATUS_INTERFACE_MAX_SELECT_MS=0
BRIDGE_STATUS_INTERFACE_SCHEDULE_REFRESH=true
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Toll capture ANPR images (same storage pattern as vehicle images; unset = use VEHICLE_IMAGES_PATH / Vehicle::getImageBasePath()).
# TOLL_CAPTURE_IMAGES_PATH=
# TOLL_CAPTURE_MAX_IMAGE_BYTES=10485760
# TOLL_CAPTURE_MAX_BASE64_CHARS=30000000
# TOLL_CAPTURE_MAX_FILE_UPLOAD_KB=2048
# TOLL_CAPTURE_PNG_COMPRESSION=2

# Account transfer approval documents (private storage; PDF only by default).
# ACCOUNT_TRANSFER_DOCUMENT_DISK=local
# ACCOUNT_TRANSFER_DOCUMENT_DIRECTORY=account-transfers
# ACCOUNT_TRANSFER_DOCUMENT_MAX_KB=10240

# Vehicle images: writable directory for stored files (defaults to storage/app/vehicle-images).
# VEHICLE_MAX_IMAGE_FILE_KB=20480
# VEHICLE_MAX_BASE64_CHARS=30000000
# VEHICLE_MAX_IMAGE_BYTES=26214400
# VEHICLE_PNG_COMPRESSION=2
