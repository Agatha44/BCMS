{
	"info": {
		"_postman_id": "bcms-pro-clean-api",
		"name": "BCMS Pro API",
		"description": "Bridge Control Management System Pro — API collection.\n\n**Auth:** Run **🔐 Authentication → Login — back office (Sanctum)** first (`POST /api/auth/login`). The Tests script saves `data.token` to `bearer_token` and `token` for `Authorization: Bearer {{bearer_token}}` on other requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "bcms-pro"
	},
	"item": [
		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "Login — back office (Sanctum)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// POST /api/auth/login — response: { success, status_code, data: { token, user, roles }, message }",
									"pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
									"",
									"let body;",
									"try {",
									"    body = pm.response.json();",
									"} catch (e) {",
									"    pm.test('Body is JSON', function () { pm.expect.fail('Response is not JSON: ' + e); });",
									"}",
									"if (typeof body === 'undefined') { return; }",
									"const token = body && body.data && body.data.token;",
									"const ok = body && body.success === true && Number(body.status_code) === 1 && token && typeof token === 'string';",
									"",
									"if (ok) {",
									"    pm.collectionVariables.set('bearer_token', token);",
									"    pm.collectionVariables.set('token', token);",
									"    if (pm.environment.name) {",
									"        pm.environment.set('bearer_token', token);",
									"        pm.environment.set('token', token);",
									"    }",
									"    const uid = body.data.user && body.data.user.id;",
									"    if (uid != null) { pm.collectionVariables.set('user_id', String(uid)); }",
									"    pm.test('Sanctum token saved', function () {",
									"        pm.expect(pm.collectionVariables.get('bearer_token')).to.eql(token);",
									"    });",
									"    console.log('Saved bearer_token + token (and user_id if present).');",
									"} else {",
									"    const msg = (body && body.message) ? body.message : pm.response.text();",
									"    pm.test('Login shape / token', function () {",
									"        pm.expect(ok, 'Expected success=true, status_code=1, data.token — got: ' + msg).to.be.true;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"your_username\",\n    \"password\": \"your_password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Back-office staff login (`AuthUser`, Laravel Sanctum).\\n\\n**Response:** `success`, `status_code` (1 = OK), `data.token` (use as `Authorization: Bearer …`), `data.user`, `data.roles`.\\n\\n**Tests:** writes `bearer_token`, `token`, and `user_id` (collection + active environment)."
					},
					"response": []
				},
				{
					"name": "Current user",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{bearer_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/user",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"user"
							]
						},
						"description": "GET /api/auth/user — requires Bearer token from Login."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{bearer_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "POST /api/auth/logout — revokes current Sanctum token."
					},
					"response": []
				}
			],
			"description": "Back-office authentication: **Login** (`POST /api/auth/login`) stores `data.token` into `bearer_token` and `token`. Use **Bearer {{bearer_token}}** or Postman Bearer auth with the same variable on protected routes."
		},
